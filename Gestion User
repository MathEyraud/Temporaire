/**
 * @description Ouvre la fiche en MODIFICATION pour l'utilisateur selectionne.
 * @param {string} loginUser - Login XWiki de l'utilisateur a editer
 */
function GOAL_GestUser_Edit(loginUser) {

	if (debugMode) console.log("\n----- GOAL_GestUser_Edit -----");

	vModeFiche = FICHE_EDITION;

	GOAL_SetTexte(elt_DetailEyebrow, "Fiche utilisateur");
	GOAL_SetTexte(elt_SaveLabel, "Enregistrer");

	GOAL_Afficher(elt_DetailUserContainer, true);
	GOAL_Afficher(elt_span_closeEditUserGOAL, true);
	GOAL_Afficher(elt_span_saveUserGOAL, true);

	// Suppression accessible uniquement sur un compte existant
	GOAL_Afficher(elt_btnSupprimerUser, mode === MODE_ADMIN);
	GOAL_Afficher(elt_ConfirmSuppression, false);

	// La fiche remplace la carte d'invitation
	GOAL_Afficher(elt_EmptyState, false);

	// Mise en evidence de la ligne selectionnee
	const voldTR = document.getElementById('TR_' + vOldUser);
	if (voldTR) voldTR.classList.remove('is-selected');

	const vnewTR = document.getElementById('TR_' + loginUser);
	if (vnewTR) vnewTR.classList.add('is-selected');

	vOldUser = loginUser;

	GOAL_GestUser_EditRequest(loginUser);
}

/**
 * @description Ouvre la fiche en CREATION d'un nouveau compte.
 *              Remplace l'ancienne modal : meme formulaire, meme emplacement.
 */
function GOAL_GestUser_NouveauCompte() {

	if (debugMode) console.log("\n----- GOAL_GestUser_NouveauCompte -----");

	if (mode !== MODE_ADMIN) {
		new XWiki.widgets.Notification('Droits administrateur requis.', 'error');
		return;
	}

	vModeFiche = FICHE_CREATION;

	const voldTR = document.getElementById('TR_' + vOldUser);
	if (voldTR) voldTR.classList.remove('is-selected');
	vOldUser = "";

	GOAL_ReinitialiserFiche();

	GOAL_SetTexte(elt_DetailEyebrow, "Nouveau compte");
	GOAL_SetTexte(elt_DetailTitle, "Creation d'un utilisateur");
	GOAL_SetTexte(elt_SaveLabel, "Creer le compte");

	GOAL_Afficher(elt_DetailUserContainer, true);
	GOAL_Afficher(elt_span_saveUserGOAL, true);
	GOAL_Afficher(elt_span_closeEditUserGOAL, true);

	// Rien a supprimer sur un compte qui n'existe pas encore
	GOAL_Afficher(elt_btnSupprimerUser, false);
	GOAL_Afficher(elt_ConfirmSuppression, false);
	GOAL_Afficher(elt_EmptyState, false);

	GOAL_AppliquerVerrouillage();
	GOAL_SetModifie(false);

	const vSelectLogin = document.getElementById(elt_Select_Login_NewUser);
	if (vSelectLogin && vSelectLogin.selectize) vSelectLogin.selectize.focus();
}

/**
 * @description Ferme la fiche et revient a l'etat initial.
 */
function GOAL_FermerFiche() {

	GOAL_Afficher(elt_span_closeEditUserGOAL, false);
	GOAL_Afficher(elt_span_saveUserGOAL, false);
	GOAL_Afficher(elt_DetailUserContainer, false);
	GOAL_Afficher(elt_ErrorDetailUserContainer, false);
	GOAL_Afficher(elt_btnSupprimerUser, false);
	GOAL_Afficher(elt_ConfirmSuppression, false);

	// Retour a l'etat initial : la colonne de droite ne doit jamais rester vide
	GOAL_Afficher(elt_EmptyState, true);

	const voldTR = document.getElementById('TR_' + vOldUser);
	if (voldTR) voldTR.classList.remove('is-selected');

	vModeFiche = FICHE_EDITION;
	vOldUser = "";
	GOAL_ReinitialiserFiche();
}


