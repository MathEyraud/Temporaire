/**
 * @description Passe le bouton de mise a jour du modele en etat de chargement.
 *              Expose separement pour pouvoir encadrer un gestionnaire existant
 *              sans reprendre la logique d'appel : appeler cette fonction avant
 *              le traitement, et GOAL_TerminerMajModeleImport() apres.
 */
function GOAL_DemarrerMajModeleImport() {
	GOAL_SetChargementBouton(elt_btnMajModeleImport, elt_MajModeleImportLabel, true, "Mise a jour en cours...");
}

/**
 * @description Restaure le bouton de mise a jour du modele.
 */
function GOAL_TerminerMajModeleImport() {
	GOAL_SetChargementBouton(elt_btnMajModeleImport, elt_MajModeleImportLabel, false);
}

/**
 * @description Regenere le modele d'import GOAL.
 *              La regeneration porte sur un classeur complet : elle prend
 *              plusieurs secondes, pendant lesquelles le bouton doit signaler
 *              l'attente et refuser tout nouveau clic.
 *
 *              Warning : le nom de cette fonction est conserve tel quel, il
 *              peut etre reference ailleurs dans l'application.
 * @returns {Promise<void>}
 */
async function fctMajModeleImportGOAL() {

	if (debugMode) console.log("\n----- fctMajModeleImportGOAL -----");

	const urlImportGroovy = new XWiki.Document(DOC_MAJ_MODELE_IMPORT.page, DOC_MAJ_MODELE_IMPORT.space).getURL('get');
	const urlMajModele = urlImportGroovy + "?outputSyntax=plain&type=MajModeleImportGOAL";

	// Notification remplacable plutot qu'une notification finale isolee :
	// l'utilisateur suit une seule ligne du debut a la fin du traitement.
	const vMSGnotification = new XWiki.widgets.Notification('Mise a jour du modele en cours...', 'inprogress');

	GOAL_DemarrerMajModeleImport();

	let majStatus;

	try {
		await fetch(urlMajModele)
			.then(response => response.json())
			.then(response => { majStatus = response.status; });

	} catch (e) {
		// La version precedente n'avait pas de catch : une coupure reseau
		// laissait la notification "en cours" indefiniment a l'ecran.
		console.error(e);
		vMSGnotification.replace(new XWiki.widgets.Notification('Une erreur s\'est produite lors de la mise a jour du modele', 'error'));
		return;

	} finally {
		// Restauration systematique : le bouton doit redevenir utilisable
		// y compris sur le chemin d'erreur, la page n'etant pas rechargee.
		GOAL_TerminerMajModeleImport();
	}

	if (majStatus == "success") {
		vMSGnotification.replace(new XWiki.widgets.Notification("Modele mis a jour", "done"));
	} else {
		vMSGnotification.replace(new XWiki.widgets.Notification('Une erreur s\'est produite lors de la mise a jour du modele', 'error'));
	}
}


