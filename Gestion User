/**
 * @description Extrait les parametres de la query string courante.
 * @returns {Object} Dictionnaire cle -> [valeur] (valeur encapsulee dans un tableau)
 */
function GOALGetQueryParams() {
	var params = {};
	var queryString = window.location.search.substring(1);
	var regex = /([^&=]+)=([^&]*)/g;
	var match;
	while (match = regex.exec(queryString)) {
		params[decodeURIComponent(match[1])] = [decodeURIComponent(match[2])];
	}
	return params;
}

