/**
 * GOAL PDE - Initialisation du widget selectize des unites organisationnelles
 * USER_GOAL.Macro.UGOAL_FicheSpecifique
 *
 * Alimente le selecteur Input_Liste_UO_Update_User a partir du referentiel
 * DataGOAL.ContextGOAL.GOAL_Metadata_S_UO_Pilote. Le selecteur reste large
 * ([id*="Input_Liste_UO"]) pour rester tolerant a d'eventuels autres champs.
 *
 * Warning : le callback onChange est le SEUL point de detection fiable des
 * modifications d'UO. Selectize masque l'element d'origine et ne propage pas
 * systematiquement d'evenement 'change' exploitable sur celui-ci. C'est donc
 * ici qu'est declenchee la notification qui active le bouton d'enregistrement.
 */
require(['jquery', 'xwiki-selectize'], function ($) {

	/**
	 * Collateur francais partage : un tri par localeCompare sans locale
	 * explicite depend de la configuration du navigateur, et un tri brut
	 * rejetterait les libelles accentues apres le Z.
	 * 'accent' -> insensible a la casse, sensible aux accents pour le departage.
	 */
	const vCollateur = new Intl.Collator('fr', { sensitivity: 'accent' });

	const GOAL_Metadata_base = (new XWiki.Document('GOAL_Metadata_base', 'DataGOAL.ContextGOAL')).getURL('get', '&outputSyntax=plain');

	[...document.querySelectorAll('[id*="Input_Liste_UO"]')].forEach(el => {

		const $el = $(el);

		$el.xwikiSelectize({

			/**
			 * @description Charge les UO du referentiel, filtrees sur la saisie.
			 * @param {string} query - Texte saisi par l'utilisateur
			 * @param {Function} cb - Callback selectize
			 */
			load: (query, cb) => {
				fetch(
					GOAL_Metadata_base.replace('base', 'S_UO_Pilote')
				).then(
					response => response.json()
				).then(
					response => {
						cb(
							response.filter(
								o => o['value'].includes(query)
							).sort(
								(a, b) => vCollateur.compare(a['value'], b['value'])
							).map(
								it => ({ label: it['value'], value: it['value'] })
							)
						);
					}
				).catch(
					err => {
						console.error(err);
						cb({});
					}
				);
			},

			/**
			 * @description Active le suivi des modifications de la fiche.
			 *              La fonction appelee est definie dans
			 *              UGOAL_FicheSpecifique.js : on verifie sa presence pour
			 *              rester tolerant aux profils ou la fiche n'est pas rendue.
			 *              L'appel est ignore pendant le chargement du formulaire
			 *              (drapeau vChargementEnCours cote fiche).
			 * @param {string|Array} value - Nouvelle valeur du selectize
			 */
			onChange: (value) => {
				if (typeof GOAL_NotifierModification === 'function') {
					GOAL_NotifierModification();
				}
			},

			/**
			 * @description Restitue l'option supprimee dans la liste des choix.
			 * @param {Array} values - Valeurs retirees
			 */
			onDelete: (values) => {
				setTimeout(
					(oldOption) => {
						el.selectize.addOption(oldOption);
						el.selectize.refreshOptions();
					},
					100,
					{ ...el.selectize.options[values[0]] }
				);
			},

			maxOptions: 1000,
			create: false,
			hideSelected: false
		});
	});
});
