<script type="text/javascript">
	/**
	 * @description Inverse l'ordre de tri de la liste des utilisateurs via l'URL.
	 */
	function toggleSort() {
		let currentUrl = window.location.href;
		currentUrl = currentUrl.replace(/[?&]sortOrder=[01]/g, '');
		currentUrl = currentUrl.replace(/\\?$/g, '');
		const separator = currentUrl.indexOf('?') !== -1 ? '&' : '?';
		const newSortOrder = ($sortOrder == 0) ? 1 : 0;
		window.location.href = currentUrl + separator + 'sortOrder=' + newSortOrder;
	}
</script>

