/**
 * Collateur unique pour tous les tris de libelles de l'ecran.
 * 'accent' -> insensible a la casse, mais sensible aux accents pour le
 * departage. Equivalent du Collator SECONDARY utilise cote Groovy.
 * Warning : Intl.Collator est couteux a instancier, on le cree une seule fois.
 */
const GOAL_CollateurLibelles = new Intl.Collator('fr', { sensitivity: 'accent' });

/**
 * @description Compare deux libelles selon les regles alphabetiques francaises.
 *              Un tri brut rejetterait les libelles accentues apres le Z, les
 *              caracteres accentues ayant un code superieur aux autres.
 * @param {string} a - Premier libelle
 * @param {string} b - Second libelle
 * @returns {number} Negatif, zero ou positif
 */
function GOAL_ComparerLibelles(a, b) {
	return GOAL_CollateurLibelles.compare((a || '').toString(), (b || '').toString());
}

/**
 * @description Trie une liste de libelles par ordre alphabetique, en ecartant
 *              les valeurs vides.
 * @param {Array<string>} liste - Libelles a trier
 * @returns {Array<string>} Nouvelle liste triee
 */
function GOAL_TrierLibelles(liste) {
	return (liste || [])
		.map(v => (v || '').toString().trim())
		.filter(v => v !== '')
		.sort(GOAL_ComparerLibelles);
}

/**
 * @description Affiche ou masque un element via la classe utilitaire .ug-is-hidden.
 * @param {string} id - Identifiant de l'element
 * @param {boolean} visible - true pour afficher, false pour masquer
 */
function GOAL_Afficher(id, visible) {
	const vElt = document.getElementById(id);
	if (!vElt) return;
	vElt.classList.toggle(CSS_HIDDEN, !visible);
}

/**
 * @description Renseigne le contenu textuel d'un element s'il existe.
 * @param {string} id - Identifiant de l'element
 * @param {string} texte - Texte a afficher
 */
function GOAL_SetTexte(id, texte) {
	const vElt = document.getElementById(id);
	if (vElt) vElt.textContent = texte;
}

/**
 * @description Retourne les checkbox programme de la fiche.
 * @returns {Array<HTMLInputElement>} Liste des checkbox programme
 */
function GOAL_GetCheckboxesProgramme() {
	const vTable = document.getElementById(elt_TableProgramme);
	return vTable ? Array.from(vTable.querySelectorAll('input[type="checkbox"]')) : [];
}

/**
 * @description Retourne le login courant de la fiche, quel que soit le controle
 *              de saisie actif : champ texte en modification, selectize en creation.
 * @returns {string} Login, chaine vide si absent
 */
function GOAL_GetLoginFiche() {

	if (vModeFiche === FICHE_CREATION) {
		const vSelectLogin = document.getElementById(elt_Select_Login_NewUser);
		if (!vSelectLogin) return "";
		const vValeur = (vSelectLogin.selectize)
			? (vSelectLogin.selectize.getValue() || "")
			: (vSelectLogin.value || "");
		return String(vValeur).trim();
	}

	const vInputLogin = document.getElementById(elt_Input_Login_Update_User);
	return vInputLogin ? vInputLogin.value.trim() : "";
}

/**
 * @description Affiche l'identite de la personne en tete de fiche.
 *              Le titre porte "Prenom Nom" et le login est rappele en dessous.
 *              Si aucune identite n'est renseignee dans le compte XWiki, le
 *              titre reprend le login et la ligne du dessous reste vide : elle
 *              disparait alors d'elle-meme (regle :empty du SSX).
 * @param {string} login - Login XWiki
 * @param {string} nomComplet - Identite "Prenom Nom", eventuellement vide
 */
function GOAL_AfficherIdentite(login, nomComplet) {

	const vNom = (nomComplet || '').trim();

	GOAL_SetTexte(elt_DetailTitle, vNom !== "" ? vNom : login);
	GOAL_SetTexte(elt_DetailLogin, vNom !== "" ? login : "");
}

/**
 * @description Bascule un bouton en etat de chargement : anneau tournant,
 *              bouton desactive et libelle remplace le temps de l'appel serveur.
 * @param {string} idBouton - Identifiant du bouton
 * @param {string} idLibelle - Identifiant du span portant le libelle
 * @param {boolean} enCours - true pour activer l'etat de chargement
 * @param {string} [texteChargement] - Libelle affiche pendant l'attente
 */
function GOAL_SetChargementBouton(idBouton, idLibelle, enCours, texteChargement) {

	const vBouton = document.getElementById(idBouton);
	if (!vBouton) return;

	const vLibelle = document.getElementById(idLibelle);

	if (enCours) {
		if (vLibelle && !vLibelle.dataset.libelleInitial) {
			vLibelle.dataset.libelleInitial = vLibelle.textContent;
		}
		if (vLibelle && texteChargement) {
			vLibelle.textContent = texteChargement;
		}
		vBouton.classList.add('is-loading');
		vBouton.disabled = true;
		vBouton.setAttribute('aria-busy', 'true');

	} else {
		if (vLibelle && vLibelle.dataset.libelleInitial) {
			vLibelle.textContent = vLibelle.dataset.libelleInitial;
		}
		vBouton.classList.remove('is-loading');
		vBouton.disabled = false;
		vBouton.removeAttribute('aria-busy');
	}
}

/**
 * @description Marque la fiche comme modifiee ou propre.
 *              Le bouton d'enregistrement est neutre et desactive quand la fiche
 *              est propre, rouge et pulsant des la premiere modification.
 * @param {boolean} estModifie - Etat de modification
 */
function GOAL_SetModifie(estModifie) {

	vEstModifie = estModifie;

	const vBtnSave = document.getElementById(elt_span_saveUserGOAL);
	if (!vBtnSave) return;

	// En lecture seule, ou si le login choisi existe deja, le bouton reste inerte
	if (mode === MODE_LECTURE || vLoginDejaExistant) {
		vBtnSave.disabled = true;
		return;
	}

	vBtnSave.disabled = !estModifie;
}

/**
 * @description Point d'entree unique des modifications utilisateur.
 *              Ignore les changements declenches par le chargement de la fiche.
 *              Appelee par les ecouteurs de cette page ET par le callback
 *              onChange de UGOAL_SelectizeUO.js (widget des UO pilote).
 */
function GOAL_NotifierModification() {
	if (vChargementEnCours) return;

	// Une modification en cours rend la demande de suppression caduque
	GOAL_Afficher(elt_ConfirmSuppression, false);

	GOAL_SetModifie(true);
}

/**
 * @description Selectionne automatiquement le profil par defaut lorsqu'un seul
 *              profil est attribue a l'utilisateur.
 *
 *              Le profil par defaut est une saisie obligatoire regulierement
 *              oubliee alors qu'il n'existe qu'une seule valeur possible dans
 *              la grande majorite des cas. La selection reste modifiable des
 *              qu'un second profil est coche.
 * @returns {boolean} true si une valeur a ete appliquee
 */
function GOAL_AppliquerProfilParDefautUnique() {

	const vSelect = document.getElementById(elt_Select_ProfilParDefautUpdate);
	if (!vSelect) return false;

	// L'option vide de tete n'est pas un profil selectionnable
	const vOptions = Array.from(vSelect.options).filter(o => o.value !== "");

	if (vOptions.length !== 1) return false;
	if (vSelect.value === vOptions[0].value) return false;

	vSelect.value = vOptions[0].value;
	if (debugMode) console.log("GOAL - Profil par defaut applique automatiquement : ", vSelect.value);
	return true;
}

/**
 * @description Applique le verrouillage des controles selon le mode de droits
 *              et l'etat de la fiche.
 *              - Login       : selectize de creation ou champ texte verrouille
 *              - Programmes  : editables en ADMIN et en AUTO_PRG
 *              - UO, profils, type de PDn : editables en ADMIN uniquement
 */
function GOAL_AppliquerVerrouillage() {

	const vLockProfils = (mode !== MODE_ADMIN);
	const vEstCreation = (vModeFiche === FICHE_CREATION);
	const vinputListeUO = document.getElementById(elt_Input_Liste_UO_Update_User);

	// --- Zone login : un seul des deux controles est visible a la fois
	GOAL_Afficher(elt_ZoneLoginLecture, !vEstCreation);
	GOAL_Afficher(elt_ZoneLoginCreation, vEstCreation);

	const vInputLogin = document.getElementById(elt_Input_Login_Update_User);
	if (vInputLogin) vInputLogin.disabled = true; // jamais saisissable en modification

	// --- Programmes
	GOAL_GetCheckboxesProgramme().forEach(cb => {
		cb.disabled = (mode === MODE_LECTURE);
	});

	// --- UO : le disabled seul ne verrouille pas le widget Selectize, il faut lock()/unlock()
	if (vinputListeUO) {
		if (vinputListeUO.selectize) {
			if (mode === MODE_ADMIN) {
				vinputListeUO.selectize.unlock();
			} else {
				vinputListeUO.selectize.lock();
			}
		}
		vinputListeUO.disabled = vLockProfils;
	}

	// --- Checkbox de profils
	PROFILS_GOAL.forEach(p => {
		const vElt = document.getElementById(p.id);
		if (vElt) vElt.disabled = vLockProfils;
	});

	// --- Profil par defaut et type de PDn
	[elt_Select_ProfilParDefautUpdate, elt_Select_PdnParDefautUpdate].forEach(id => {
		const vElt = document.getElementById(id);
		if (vElt) vElt.disabled = vLockProfils;
	});
}

/**
 * @description Vide integralement le formulaire de la fiche.
 *              Le drapeau de chargement est leve pour ne pas declencher
 *              le suivi des modifications via les callbacks selectize.
 */
function GOAL_ReinitialiserFiche() {

	vChargementEnCours = true;

	const vInputLogin = document.getElementById(elt_Input_Login_Update_User);
	if (vInputLogin) vInputLogin.value = '';

	const vSelectLogin = document.getElementById(elt_Select_Login_NewUser);
	if (vSelectLogin && vSelectLogin.selectize) {
		vSelectLogin.selectize.clear(true); // true = silencieux
	}

	GOAL_GetCheckboxesProgramme().forEach(cb => { cb.checked = false; });

	PROFILS_GOAL.forEach(p => {
		const vElt = document.getElementById(p.id);
		if (vElt) vElt.checked = false;
	});

	const vinputListeUO = document.getElementById(elt_Input_Liste_UO_Update_User);
	if (vinputListeUO) {
		if (vinputListeUO.selectize) {
			vinputListeUO.selectize.clear(true);
		} else {
			vinputListeUO.value = '';
		}
	}

	const vSelectProfilDefaut = document.getElementById(elt_Select_ProfilParDefautUpdate);
	if (vSelectProfilDefaut) {
		vSelectProfilDefaut.innerHTML = '<option value="" selected> </option>';
	}

	const vSelectPdn = document.getElementById(elt_Select_PdnParDefautUpdate);
	if (vSelectPdn && vSelectPdn.options.length > 0) {
		vSelectPdn.selectedIndex = 0;
	}

	GOAL_Afficher(elt_ErrorDetailUserContainer, false);
	GOAL_SetTexte(elt_DetailLogin, "");

	const vHelp = document.getElementById(elt_HelpBlock);
	if (vHelp) vHelp.classList.remove('is-visible');

	vLoginDejaExistant = false;

	setTimeout(() => { vChargementEnCours = false; }, 0);
}


