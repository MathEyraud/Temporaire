<script type="text/javascript">

	/**
	 * @description Synchronise la liste des profils par defaut avec les cases
	 *              a cocher de profil cochees.
	 */
	function updateDefaultProfilUpdateUser() {

		const eltSelectId = `$elt_Select_ProfilParDefautUpdate`;
		const profileCheckboxes = document.querySelectorAll('#div_Liste_Profil input[type="checkbox"]');
		const defaultProfileSelect = document.getElementById(eltSelectId);

		if (!defaultProfileSelect) { return; }

		function updateDefaultProfileList() {
			defaultProfileSelect.innerHTML = '<option value="" selected> </option>';

			profileCheckboxes.forEach(checkbox => {
				const option = defaultProfileSelect.querySelector(`option[value="${checkbox.name}"]`);

				if (checkbox.checked) {
					if (!option) {
						const newOption = document.createElement('option');
						newOption.id = checkbox.id;
						newOption.value = checkbox.name;
						newOption.textContent = checkbox.nextSibling.textContent.trim();
						defaultProfileSelect.appendChild(newOption);
					}
				} else if (option) {
					defaultProfileSelect.removeChild(option);
				}
			});
		}

		profileCheckboxes.forEach(checkbox => {
			checkbox.addEventListener('change', () => {
				updateDefaultProfileList();
				// Un seul profil coche : il devient le profil par defaut sans
				// intervention. Defini dans UGOAL_FicheSpecifique.js.
				if (typeof GOAL_AppliquerProfilParDefautUnique === 'function') {
					GOAL_AppliquerProfilParDefautUnique();
				}
			});
		});

		updateDefaultProfileList();
	}

	document.addEventListener('DOMContentLoaded', function() {
		updateDefaultProfilUpdateUser();
	});

</script>
