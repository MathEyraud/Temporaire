/**
 * @description Verifie si la chaine contient le prefixe "xwiki:XWiki".
 * @param {string} str - La chaine a verifier
 * @returns {boolean} true si la chaine contient "xwiki:XWiki", sinon false
 */
function containsXWikiPrefix(str) {
	const regex = /^xwiki:XWiki\./;
	return regex.test(str);
}

/**
 * @description Interroge le serveur pour savoir si le compte GOAL existe deja.
 *              Bloque l'enregistrement le cas echeant.
 * @param {string} loginUser - Login XWiki choisi
 * @returns {Promise<void>}
 */
async function GOAL_checkNewUser(loginUser) {

	if (debugMode) console.log("----- GOAL_checkNewUser -----");

	const urlGestUserGroovy = new XWiki.Document('UGOAL_GestUserGroovy', 'USER_GOAL.Macro').getURL('get');
	const urlGestUserGroovyRequest = urlGestUserGroovy
		+ "?outputSyntax=plain&type=NUserRequestInfos&Login=" + encodeURIComponent(loginUser);

	const vHelp = document.getElementById(elt_HelpBlock);
	if (vHelp) vHelp.classList.remove('is-visible');

	// Le bouton est bloque le temps de la verification : sur connexion lente,
	// il resterait cliquable alors que l'existence du compte est inconnue.
	vLoginDejaExistant = true;
	GOAL_SetModifie(vEstModifie);
	GOAL_Afficher(elt_LoginLoading, true);

	let estDejaExistant;
	let vNomComplet = "";
	let enErreur = false;

	await fetch(urlGestUserGroovyRequest)
		.then(response => response.json())
		.then(response => {
			estDejaExistant = response.estDejaExistant;
			vNomComplet = response.S_NomComplet || "";
		})
		.catch(e => { console.error(e); enErreur = true; });

	GOAL_Afficher(elt_LoginLoading, false);

	if (enErreur) {
		new XWiki.widgets.Notification('Impossible de verifier ce login.', 'error');
		return;
	}

	vLoginDejaExistant = !!estDejaExistant;
	if (vHelp) vHelp.classList.toggle('is-visible', vLoginDejaExistant);

	// L'identite du compte XWiki choisi s'affiche des la selection
	GOAL_AfficherIdentite(loginUser, vNomComplet);

	// Reevalue l'etat du bouton : bloque si le compte existe deja
	GOAL_SetModifie(vEstModifie);
}

/**
 * @description Pre-verification du login choisi. Appelee par le widget selectize
 *              du login (onChange) et par les ecouteurs de cette page.
 *              Sans effet hors du mode creation.
 */
function GOAL_NewUser_Login_Check() {

	if (vModeFiche !== FICHE_CREATION) return;

	let vLogin = GOAL_GetLoginFiche();
	if (vLogin === "") return;

	// Prefiltrage : retire le prefixage eventuel du suggesteur XWiki
	if (containsXWikiPrefix(vLogin)) {
		vLogin = vLogin.substring("xwiki:XWiki.".length);
	}

	// Le titre definitif est pose par GOAL_checkNewUser une fois l'identite
	// connue : on n'affiche ici que le login, en attendant la reponse.
	GOAL_AfficherIdentite(vLogin, "");
	GOAL_NotifierModification();
	GOAL_checkNewUser(vLogin);
}


