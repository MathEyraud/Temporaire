/**
 * @description Charge les informations d'un utilisateur et alimente le formulaire.
 * @param {string} loginUser - Login XWiki de l'utilisateur a charger
 * @returns {Promise<boolean|void>} false en cas d'erreur de requete
 */
async function GOAL_GestUser_EditRequest(loginUser) {

	if (debugMode) console.log("\n----- GOAL_GestUser_EditRequest -----");

	vChargementEnCours = true;
	vLoginDejaExistant = false;

	const urlGestUserGroovy = new XWiki.Document('UGOAL_GestUserGroovy', 'USER_GOAL.Macro').getURL('get');
	const urlGestUserGroovyRequest = urlGestUserGroovy
		+ "?outputSyntax=plain&type=RequestInfos&Login=" + encodeURIComponent(loginUser);

	const vInputLogin = document.getElementById(elt_Input_Login_Update_User);
	const vinputListeUO = document.getElementById(elt_Input_Liste_UO_Update_User);
	const vSelectProfilDefaut = document.getElementById(elt_Select_ProfilParDefautUpdate);
	const vSelectPdnDefaut = document.getElementById(elt_Select_PdnParDefautUpdate);

	let vInfos = null;

	// Reinitialisation des champs
	vInputLogin.value = loginUser;
	vSelectProfilDefaut.value = '';

	GOAL_GetCheckboxesProgramme().forEach(cb => { cb.checked = false; });
	PROFILS_GOAL.forEach(p => {
		const vElt = document.getElementById(p.id);
		if (vElt) vElt.checked = false;
	});

	try {
		vInfos = await fetch(urlGestUserGroovyRequest).then(response => response.json());

	} catch (e) {
		console.error(e);
		GOAL_Afficher(elt_DetailUserContainer, false);
		GOAL_Afficher(elt_ErrorDetailUserContainer, true);
		GOAL_Afficher(elt_span_saveUserGOAL, false);
		GOAL_Afficher(elt_EmptyState, false);
		vChargementEnCours = false;
		return false;
	}

	if (debugMode) console.log("GOALUserInfoJson : ", vInfos);

	const RefLogin = vInfos.S_LoginUser;

	if (RefLogin != '') {

		vInputLogin.value = RefLogin;
		GOAL_AfficherIdentite(RefLogin, vInfos.S_NomComplet);

		// --- Liste des UO
		// Les valeurs sont stockees dans l'ordre de saisie : on les trie pour
		// que l'affichage soit alphabetique quel que soit cet ordre.
		const RefListeUOArray = GOAL_TrierLibelles((vInfos.S_ListeUO || '').split(','));

		if (vinputListeUO.selectize) {
			RefListeUOArray.forEach(element => {
				vinputListeUO.selectize.addOption({ label: element, value: element });
			});
			vinputListeUO.selectize.setValue(RefListeUOArray);

		} else {
			console.error("Selectize instance not found for the element.");
		}

		// --- Type de PDn par defaut
		if (vSelectPdnDefaut) vSelectPdnDefaut.value = vInfos.S_Type_PDN || 'PDE';

		// --- Programmes affectes
		(vInfos.S_ListeProgramme || '').split(',').map(e => e.trim()).forEach(prg => {
			const vTDSelPRG = document.getElementById('Input_SEL_' + prg);
			if (vTDSelPRG) vTDSelPRG.checked = true;
		});

		// --- Checkbox de profil
		PROFILS_GOAL.forEach(p => {
			const vElt = document.getElementById(p.id);
			if (vElt) vElt.checked = !!vInfos[p.cle];
		});

		GOAL_Afficher(elt_ErrorDetailUserContainer, false);

	} else {
		GOAL_Afficher(elt_DetailUserContainer, false);
		GOAL_Afficher(elt_span_saveUserGOAL, false);
		GOAL_Afficher(elt_btnSupprimerUser, false);
		GOAL_Afficher(elt_ErrorDetailUserContainer, true);
		GOAL_Afficher(elt_EmptyState, false);
	}

	// --- Reconstruction de la liste des profils par defaut
	// Tri alphabetique : PROFILS_GOAL est declaree dans l'ordre hierarchique
	// des droits, qui n'est pas l'ordre attendu dans une liste deroulante.
	let optionsProfil = "";
	PROFILS_GOAL
		.filter(p => vInfos[p.cle])
		.sort((a, b) => GOAL_ComparerLibelles(a.libelle, b.libelle))
		.forEach(p => {
			optionsProfil += '<option value="' + p.valeur + '">' + p.libelle + '</option>';
		});

	vSelectProfilDefaut.innerHTML = optionsProfil;
	vSelectProfilDefaut.value = vInfos.S_ProfilParDefaut || "";

	// Comble un profil par defaut absent lorsqu'un seul profil est attribue.
	// Le drapeau de chargement empeche de marquer la fiche comme modifiee :
	// la valeur ne sera persistee qu'a l'enregistrement suivant.
	if (!vInfos.S_ProfilParDefaut || vInfos.S_ProfilParDefaut === "") {
		GOAL_AppliquerProfilParDefautUnique();
	}

	GOAL_AppliquerVerrouillage();

	// Mode auto-service : GOAL_GestUser_Edit() n'est jamais appele,
	// on revele donc ici la fiche et le bouton d'enregistrement.
	if (mode === MODE_AUTO_PRG && RefLogin != '') {
		GOAL_Afficher(elt_DetailUserContainer, true);
		GOAL_Afficher(elt_span_saveUserGOAL, true);
		GOAL_Afficher(elt_span_closeEditUserGOAL, false);
	}

	GOAL_SetModifie(false);

	// Le formulaire est alimente : le suivi des modifications reprend.
	// setTimeout(0) pour couvrir les callbacks selectize differes.
	setTimeout(() => { vChargementEnCours = false; }, 0);
}


