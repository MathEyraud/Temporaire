/**
 * @description Interroge le serveur sur la suppressibilite du compte charge,
 *              puis affiche le bandeau de confirmation en place.
 * @returns {Promise<void>}
 */
async function GOAL_GestUser_DemanderSuppression() {

	if (debugMode) console.log("\n----- GOAL_GestUser_DemanderSuppression -----");

	if (mode !== MODE_ADMIN || vModeFiche !== FICHE_EDITION) {
		new XWiki.widgets.Notification('Action non disponible dans ce contexte.', 'error');
		return;
	}

	const vLogin = GOAL_GetLoginFiche();
	if (vLogin === "") {
		new XWiki.widgets.Notification('Aucun utilisateur charge.', 'error');
		return;
	}

	const urlGestUserGroovy = new XWiki.Document('UGOAL_GestUserGroovy', 'USER_GOAL.Macro').getURL('get');
	const urlRequest = urlGestUserGroovy
		+ "?outputSyntax=plain&type=CheckDeleteUser&Login=" + encodeURIComponent(vLogin);

	let vReponse;

	// L'appel de verification peut durer plusieurs secondes : sans retour
	// visuel, le clic parait sans effet et l'utilisateur le repete.
	GOAL_SetChargementBouton(elt_btnSupprimerUser, elt_DeleteLabel, true, "Verification...");

	try {
		vReponse = await fetch(urlRequest).then(r => r.json());

	} catch (e) {
		console.error(e);
		new XWiki.widgets.Notification('Impossible de verifier ce compte.', 'error');
		return;

	} finally {
		GOAL_SetChargementBouton(elt_btnSupprimerUser, elt_DeleteLabel, false);
	}

	if (debugMode) console.log("CheckDeleteUser : ", vReponse);

	GOAL_SetTexte(elt_ConfirmLogin, vLogin);

	const vBtnValider = document.getElementById(elt_ConfirmValider);

	if (vReponse.estSupprimable === false) {
		GOAL_SetTexte(elt_ConfirmDetail, vReponse.message || "Suppression impossible.");
		if (vBtnValider) vBtnValider.disabled = true;

	} else {
		const vNb = vReponse.nbReferences || 0;
		GOAL_SetTexte(
			elt_ConfirmDetail,
			vNb > 0
				? "Attention : ce login est reference sur " + vNb + " echeance(s). Les donnees historiques seront conservees en l'etat."
				: "Aucune echeance ne reference ce login."
		);
		if (vBtnValider) vBtnValider.disabled = false;
	}

	GOAL_Afficher(elt_ConfirmSuppression, true);
}

/**
 * @description Ferme le bandeau de confirmation sans rien supprimer.
 */
function GOAL_GestUser_AnnulerSuppression() {
	GOAL_Afficher(elt_ConfirmSuppression, false);
	GOAL_SetTexte(elt_ConfirmDetail, "");
}

/**
 * @description Supprime effectivement le compte GOAL apres confirmation,
 *              puis recharge la page pour rafraichir la liste.
 * @returns {Promise<void>}
 */
async function GOAL_GestUser_ConfirmerSuppression() {

	if (debugMode) console.log("\n----- GOAL_GestUser_ConfirmerSuppression -----");

	const vLogin = GOAL_GetLoginFiche();
	if (vLogin === "") return;

	// Etat de chargement : couvre aussi la protection contre le double clic
	GOAL_SetChargementBouton(elt_ConfirmValider, elt_ConfirmValiderLabel, true, "Suppression...");

	const urlGestUserGroovy = new XWiki.Document('UGOAL_GestUserGroovy', 'USER_GOAL.Macro').getURL('get');
	const urlRequest = urlGestUserGroovy
		+ "?outputSyntax=plain&type=DeleteUser&Login=" + encodeURIComponent(vLogin);

	const vMSGnotification = new XWiki.widgets.Notification('Suppression en cours...', 'inprogress');

	let vStatus;
	let vMessage = "";

	try {
		await fetch(urlRequest, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ S_LoginUser: vLogin }) })
			.then(r => r.json())
			.then(r => { vStatus = r.status; vMessage = r.message || ""; });

	} catch (e) {
		console.error(e);
		vMSGnotification.replace(new XWiki.widgets.Notification('Une erreur s\'est produite lors de la suppression', 'error'));
		GOAL_SetChargementBouton(elt_ConfirmValider, elt_ConfirmValiderLabel, false);
		return;
	}

	if (vStatus === "success") {
		// L'etat de chargement est maintenu jusqu'a la redirection :
		// la page va etre rechargee, rien ne doit redevenir cliquable.
		vMSGnotification.replace(new XWiki.widgets.Notification("Compte supprime", "done"));
		setTimeout(() => {
			window.location.assign(
				new XWiki.Document('UGOAL_FicheSpecifique', 'USER_GOAL.Macro').getURL('view') + complementURL
			);
		}, 700);

	} else {
		vMSGnotification.replace(new XWiki.widgets.Notification(vMessage || 'Suppression impossible', 'error'));
		GOAL_SetChargementBouton(elt_ConfirmValider, elt_ConfirmValiderLabel, false);
	}
}


