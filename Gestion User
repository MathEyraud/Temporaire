/**
 * @description Controles de coherence puis appel de GOAL_Save.
 *              Aiguille selon l'etat de la fiche et le mode de droits.
 */
async function GOAL_GestUser_EditSave() {

	if (debugMode) console.log("\n----- GOAL_GestUser_EditSave -----");

	const vinputListeUO = document.getElementById(elt_Input_Liste_UO_Update_User);
	const vSelectProfilDefaut = document.getElementById(elt_Select_ProfilParDefautUpdate);
	const vSelectPdnDefaut = document.getElementById(elt_Select_PdnParDefautUpdate);
	const vLogin = GOAL_GetLoginFiche();

	// ---------------------------------------------------------------- //
	// CREATION d'un nouveau compte
	// ---------------------------------------------------------------- //
	if (vModeFiche === FICHE_CREATION) {

		if (vLogin === "") {
			new XWiki.widgets.Notification('Veuillez renseigner le login de l\'utilisateur !', 'error');
			return;
		}

		if (vLoginDejaExistant) {
			new XWiki.widgets.Notification('Cet utilisateur a deja un compte dans GOAL.', 'error');
			return;
		}

		if (vSelectProfilDefaut.value === "") {
			new XWiki.widgets.Notification('Veuillez renseigner le profil par defaut', 'error');
			return;
		}

		// PDE : au moins une UO est requise quel que soit le profil
		if (vinputListeUO.length === 0) {
			new XWiki.widgets.Notification('Veuillez renseigner au moins un UO !', 'error');
			return;
		}

		GOAL_Save(vLogin, vinputListeUO, vSelectProfilDefaut, vSelectPdnDefaut);
		return;
	}

	// ---------------------------------------------------------------- //
	// MODIFICATION - mode auto-service : seuls les programmes sont modifiables
	// ---------------------------------------------------------------- //
	if (mode === MODE_AUTO_PRG) {
		GOAL_Save(vLogin, vinputListeUO, vSelectProfilDefaut, vSelectPdnDefaut);
		return;
	}

	// ---------------------------------------------------------------- //
	// MODIFICATION - mode administrateur : controles complets
	// ---------------------------------------------------------------- //
	if (vSelectProfilDefaut.value != "") {

		if (vinputListeUO.length == 0) {
			new XWiki.widgets.Notification('Veuillez renseigner au moins un UO !', 'error');
			return;
		}

		GOAL_Save(vLogin, vinputListeUO, vSelectProfilDefaut, vSelectPdnDefaut);

	} else {
		// Dans le cas de la suppression des droits, le profil par defaut doit
		// pouvoir etre mis a nul, mais les UO doivent alors etre retirees.
		if (vSelectProfilDefaut.options.length <= 1) {

			if (vinputListeUO.length != 0) {
				new XWiki.widgets.Notification('Veuillez supprimer les UOs de l\'utilisateur !', 'error');
				return;
			}
			GOAL_Save(vLogin, vinputListeUO, vSelectProfilDefaut, vSelectPdnDefaut);

		} else {
			new XWiki.widgets.Notification('Veuillez renseigner le profil par defaut.', 'error');
		}
	}
}

/**
 * @description Enregistre la fiche. Endpoint et payload dependent du contexte :
 *                - FICHE_CREATION -> type=NewUser,            payload complet
 *                - MODE_ADMIN     -> type=SaveInfos,          payload complet
 *                - MODE_AUTO_PRG  -> type=SaveProgrammesAuto, login + programmes
 * @param {string} UserGOAL - Login de l'utilisateur
 * @param {HTMLSelectElement} vinputListeUO - Select (selectize) de la liste des UO
 * @param {HTMLSelectElement} vSelectProfilDefaut - Select du profil par defaut
 * @param {HTMLSelectElement} vSelectPdnDefaut - Select du type de PDn par defaut
 * @returns {Promise<boolean|void>} false en cas d'echec de la requete
 */
async function GOAL_Save(UserGOAL, vinputListeUO, vSelectProfilDefaut, vSelectPdnDefaut) {

	if (debugMode) console.log("\n----- GOAL_Save -----");

	const estCreation = (vModeFiche === FICHE_CREATION);

	// --- Collecte des programmes coches
	// Warning : contrat implicite, la valeur du programme est lue dans la
	// DEUXIEME cellule de la ligne (cells[1]).
	const ListProg = [];
	GOAL_GetCheckboxesProgramme().forEach(cbPrg => {
		if (cbPrg.checked) {
			ListProg.push(cbPrg.closest('tr').cells[1].textContent.trim());
		}
	});
	// Le tableau etant deja trie cote serveur, ce tri ne change rien
	// aujourd'hui ; il garantit la valeur stockee si l'ordre d'affichage
	// venait a evoluer.
	ListProg.sort(GOAL_ComparerLibelles);

	// --- Collecte des UO
	// Tri avant enregistrement : la valeur stockee reste alphabetique, ce qui
	// evite qu'un simple reordonnancement apparaisse comme une modification.
	const ListUO = [];
	for (let index = 0; index < vinputListeUO.length; index++) {
		ListUO.push(vinputListeUO[index].value);
	}
	ListUO.sort(GOAL_ComparerLibelles);

	// --- Endpoint
	let vTypeSave;
	if (estCreation) {
		vTypeSave = "NewUser";
	} else if (mode === MODE_AUTO_PRG) {
		vTypeSave = "SaveProgrammesAuto";
	} else {
		vTypeSave = "SaveInfos";
	}

	// --- Payload
	let requestBody;
	if (vTypeSave === "SaveProgrammesAuto") {
		requestBody = {
			S_LoginUser: UserGOAL,
			S_ListeProgramme: ListProg.join(',')
		};

	} else {
		requestBody = {
			S_LoginUser: UserGOAL,
			S_ListeProgramme: ListProg.join(','),
			S_ListeUO: ListUO.join(','),
			S_ProfilParDefaut: vSelectProfilDefaut.value,
			S_Type_PDN: vSelectPdnDefaut ? vSelectPdnDefaut.value : ''
		};
		PROFILS_GOAL.forEach(p => {
			const vElt = document.getElementById(p.id);
			requestBody[p.cle] = vElt ? vElt.checked : false;
		});
	}

	if (debugMode) console.log("requestBody : ", requestBody);

	const urlGestUserGroovy = new XWiki.Document('UGOAL_GestUserGroovy', 'USER_GOAL.Macro').getURL('get');
	const urlGestUserGroovyRequest = urlGestUserGroovy
		+ "?outputSyntax=plain&type=" + vTypeSave
		+ "&Login=" + encodeURIComponent(UserGOAL);

	let majStatus;
	let majMessage = "";
	const vMSGnotification = new XWiki.widgets.Notification('Enregistrement en cours...', 'inprogress');

	GOAL_SetChargementBouton(elt_span_saveUserGOAL, elt_SaveLabel, true, "Enregistrement...");

	try {
		await fetch(
			urlGestUserGroovyRequest,
			{ method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(requestBody) }
		)
			.then(response => response.json())
			.then(response => {
				majStatus = response.status;
				majMessage = response.message || "";
			});

	} catch (e) {
		console.error(e);
		vMSGnotification.replace(new XWiki.widgets.Notification('Une erreur s\'est produite lors de l\'enregistrement', 'error'));
		GOAL_SetChargementBouton(elt_span_saveUserGOAL, elt_SaveLabel, false);
		return false;
	}

	if (majStatus == "success") {
		vMSGnotification.replace(new XWiki.widgets.Notification("Enregistrement effectue", "done"));

		// Creation et auto-service : la page est rechargee, l'etat de
		// chargement est maintenu pour eviter toute nouvelle soumission.
		if (estCreation || mode === MODE_AUTO_PRG) {
			setTimeout(() => {
				window.location.assign(
					new XWiki.Document('UGOAL_FicheSpecifique', 'USER_GOAL.Macro').getURL('view') + complementURL
				);
			}, 700);
			return;
		}

		GOAL_SetChargementBouton(elt_span_saveUserGOAL, elt_SaveLabel, false);
		GOAL_SetModifie(false);

	} else {
		const vTexte = majMessage !== "" ? majMessage : 'Une erreur s\'est produite lors de l\'enregistrement';
		vMSGnotification.replace(new XWiki.widgets.Notification(vTexte, 'error'));
		GOAL_SetChargementBouton(elt_span_saveUserGOAL, elt_SaveLabel, false);
	}
}


