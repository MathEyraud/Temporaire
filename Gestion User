/** Bouton de reinitialisation du filtre */
const elt_btnResetFiltre = "GOALUser_resetfilter";
const elt_InputFiltre = "Input_UserFilter";

/**
 * @description Retire des caracteres susceptibles de perturber la requete XWQL
 *              construite cote velocity. Le nettoyage y est refait, celui-ci
 *              evite simplement de propager une saisie douteuse dans l'URL.
 * @param {string} valeur - Saisie brute
 * @returns {string} Saisie nettoyee
 */
function GOAL_NettoyerFiltre(valeur) {
	return (valeur || '')
		.replace(/"/g, '')
		.replace(/\\/g, '')
		.replace(/\'/g, '')
		.replace(/\`/g, '')
		.trim();
}

/**
 * @description Retourne le filtre actuellement applique, lu dans l'URL.
 *              A distinguer du contenu du champ de saisie, qui peut avoir ete
 *              modifie sans que la recherche ait ete relancee.
 * @returns {string} Filtre actif, chaine vide si aucun
 */
function GOAL_FiltreActif() {
	return vQueryParams['Filter'] ? String(vQueryParams['Filter']) : "";
}

/**
 * @description Construit l'URL de la liste en conservant le profil et l'ordre
 *              de tri courants. Utilisee par la recherche comme par la
 *              reinitialisation, afin que les deux se comportent identiquement.
 * @param {string} filtre - Filtre a appliquer, chaine vide pour aucun
 * @returns {string} URL complete
 */
function GOAL_ConstruireURLListe(filtre) {

	const vParams = [];

	if (profilCourant && profilCourant !== "" && profilCourant !== "undefined") {
		vParams.push("profil=" + encodeURIComponent(profilCourant));
	}
	if (filtre && filtre !== "") {
		vParams.push("Filter=" + encodeURIComponent(filtre));
	}
	const vSort = vQueryParams['sortOrder'] ? String(vQueryParams['sortOrder']) : "";
	if (vSort !== "") {
		vParams.push("sortOrder=" + encodeURIComponent(vSort));
	}

	const vBase = new XWiki.Document('UGOAL_FicheSpecifique', 'USER_GOAL.Macro').getURL('view');
	return (vParams.length > 0) ? vBase + "?" + vParams.join("&") : vBase;
}

/**
 * @description Affiche le bouton de reinitialisation uniquement lorsqu'il a un
 *              effet : champ renseigne, ou filtre deja applique.
 */
function GOAL_MajBoutonResetFiltre() {
	const vInput = document.getElementById(elt_InputFiltre);
	const vSaisie = vInput ? vInput.value.trim() : "";
	GOAL_Afficher(elt_btnResetFiltre, (vSaisie !== "" || GOAL_FiltreActif() !== ""));
}

/**
 * @description Lance la recherche sur la saisie courante.
 */
function GOAL_AppliquerFiltre() {
	const vInput = document.getElementById(elt_InputFiltre);
	const vFiltre = GOAL_NettoyerFiltre(vInput ? vInput.value : "");
	window.location.assign(GOAL_ConstruireURLListe(vFiltre));
}

/**
 * @description Reinitialise le filtre de recherche.
 *              Si un filtre est applique, la page est rechargee sans le
 *              parametre Filter. Sinon, le champ est simplement vide : inutile
 *              de recharger la page pour une saisie jamais validee.
 */
function GOAL_ReinitialiserFiltre() {

	const vInput = document.getElementById(elt_InputFiltre);
	if (vInput) vInput.value = "";

	if (GOAL_FiltreActif() !== "") {
		window.location.assign(GOAL_ConstruireURLListe(""));
		return;
	}

	GOAL_MajBoutonResetFiltre();
	if (vInput) vInput.focus();
}

/**
 * @description Branche l'ensemble des ecouteurs d'evenements de la page.
 *              Tous les acces au DOM sont proteges : les blocs administrateur
 *              peuvent ne pas etre rendus par le velocity selon le profil.
 */
function GOAL_InitEvenements() {

	// --- Filtre utilisateur (administrateur)
	const spanGOALUser_applyfilter = document.getElementById("GOALUser_applyfilter");
	if (spanGOALUser_applyfilter) {
		spanGOALUser_applyfilter.addEventListener("click", GOAL_AppliquerFiltre);
	}

	const vBtnResetFiltre = document.getElementById(elt_btnResetFiltre);
	if (vBtnResetFiltre) {
		vBtnResetFiltre.addEventListener("click", GOAL_ReinitialiserFiltre);
	}

	// --- Entree pour rechercher, Echap pour reinitialiser
	const vInputFilter = document.getElementById(elt_InputFiltre);
	if (vInputFilter) {
		vInputFilter.addEventListener("keydown", (e) => {
			if (e.key === "Enter")  { e.preventDefault(); GOAL_AppliquerFiltre(); }
			if (e.key === "Escape") { e.preventDefault(); GOAL_ReinitialiserFiltre(); }
		});
		vInputFilter.addEventListener("input", GOAL_MajBoutonResetFiltre);
	}

	GOAL_MajBoutonResetFiltre();

	// --- Mise a jour du modele d'import (administrateur)
	// Warning : branchement unique. Si l'ancien couple listener + fonction
	// subsiste dans un autre fichier, le retirer sous peine de declencher
	// la regeneration deux fois par clic.
	const button_MajModeleImportGOAL = document.getElementById(elt_btnMajModeleImport);
	if (button_MajModeleImportGOAL) {
		button_MajModeleImportGOAL.addEventListener("click", fctMajModeleImportGOAL);
	}

	// --- Revue de compte (administrateur)
	const vSpanGOAL_RevueCompte = document.getElementById('SpanGOAL_RevueCompte');
	if (vSpanGOAL_RevueCompte) {
		vSpanGOAL_RevueCompte.addEventListener("click", () => {
			window.location.assign(new XWiki.Document('UGOAL_TableRevue', 'USER_GOAL.Macro').getURL('view') + complementURL);
		});
	}

	// --- Fermeture / annulation de la fiche
	const vspanCloseEdit = document.getElementById(elt_span_closeEditUserGOAL);
	if (vspanCloseEdit) {
		vspanCloseEdit.addEventListener("click", GOAL_FermerFiche);
	}

	// --- Programmes : coherence + suivi des modifications
	GOAL_GetCheckboxesProgramme().forEach(checkbox => {
		checkbox.addEventListener('change', GOAL_NotifierModification);
	});

	// --- UO (le callback selectize appelle aussi cette fonction)
	const vUOUpdate = document.getElementById(elt_Input_Liste_UO_Update_User);
	if (vUOUpdate) {
		vUOUpdate.addEventListener('change', GOAL_NotifierModification);
	}

	// --- Profils
	PROFILS_GOAL.forEach(p => {
		const vElt = document.getElementById(p.id);
		if (vElt) vElt.addEventListener('change', GOAL_NotifierModification);
	});

	// --- Profil par defaut et type de PDn
	[elt_Select_ProfilParDefautUpdate, elt_Select_PdnParDefautUpdate].forEach(id => {
		const vElt = document.getElementById(id);
		if (vElt) vElt.addEventListener('change', GOAL_NotifierModification);
	});

	// --- Selecteur de login en creation
	// Le widget selectize est initialise ailleurs : on se branche sur l'element
	// natif, ce qui couvre le cas ou son onChange n'appellerait pas deja
	// GOAL_NewUser_Login_Check().
	const vSelectLogin = document.getElementById(elt_Select_Login_NewUser);
	if (vSelectLogin) {
		vSelectLogin.addEventListener('change', GOAL_NewUser_Login_Check);
	}
}

/**
 * @description Chargement automatique de la fiche de l'utilisateur courant
 *              pour les modes non administrateur (lecture et auto-service).
 */
function GOAL_InitChargementAuto() {

	if (mode === MODE_ADMIN) return;

	require(['xwiki-meta'], function (xm) {
		const xwiki_user = XWiki.Model.serialize(xm.userReference);
		const loginUser = xwiki_user.substring(12, xwiki_user.length);
		GOAL_GestUser_EditRequest(loginUser);
	});
}

// --- Point d'entree
document.addEventListener('DOMContentLoaded', function () {
	GOAL_DeplacerHorsConteneurXWiki();
	GOAL_InitEvenements();
	GOAL_SetModifie(false);
	GOAL_InitChargementAuto();
});


















