	// Recuperation des variables depuis le binding
	def listeOriginal = ListeUserGOAL;
	def sortOrder = sortOrder; // 0 = croissant, 1 = decroissant

	def listeTriee = new ArrayList();
	for (def element : listeOriginal) {
		listeTriee.add(element);
	}

	listeTriee.sort { a, b ->
		def valeurA = a[0] ? a[0].toString() : '';
		def valeurB = b[0] ? b[0].toString() : '';

		if (sortOrder == 0) {
			return valeurA.compareToIgnoreCase(valeurB); // Croissant
		} else {
			return valeurB.compareToIgnoreCase(valeurA); // Decroissant
		}
	}

	binding.setVariable("listeTriee", listeTriee);


	// ------------------------------------------------------------------ //
	// Tri alphabetique du referentiel des programmes
	//
	// $jsonProg provient de $jsontool.parse() : l'ordre y est celui du
	// document de metadonnees, qui suit l'ordre de saisie et non l'alphabet.
	// Le tri est fait ici plutot qu'en Velocity, $collectiontool.sort()
	// s'appuyant sur l'introspection de bean et non sur l'acces par cle.
	//
	// Collator FRENCH : un tri brut placerait "Zebre" avant "Ecole" des lors
	// qu'un libelle porte un accent, les caracteres accentues ayant un code
	// superieur aux lettres non accentuees.
	// ------------------------------------------------------------------ //
	def listeProgTriee = new ArrayList();

	for (def prg : jsonProg) {
		listeProgTriee.add(prg);
	}

	try {
		def collateur = java.text.Collator.getInstance(java.util.Locale.FRENCH);
		collateur.setStrength(java.text.Collator.SECONDARY); // ignore la casse

		listeProgTriee.sort { a, b ->
			def nomA = a['NomProg'] ? a['NomProg'].toString().trim() : '';
			def nomB = b['NomProg'] ? b['NomProg'].toString().trim() : '';
			return collateur.compare(nomA, nomB);
		}

	} catch (e) {
		// Repli : en cas d'anomalie du referentiel, on conserve l'ordre
		// d'origine plutot que de rendre la liste des programmes vide.
		System.out.println("Tri des programmes : Exception " + e);
	}

	binding.setVariable("listeProgTriee", listeProgTriee);

